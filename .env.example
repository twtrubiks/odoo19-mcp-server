ODOO_URL=your_odoo_url_here
ODOO_DATABASE=your_database_key_here
ODOO_API_KEY=your_api_key_here
READONLY_MODE=false
# HTTP/SSE 模式的 Bearer Token 認證（選用，未設定＝無認證；stdio 模式用不到）
# 產生方式：openssl rand -hex 32
# MCP_AUTH_TOKEN=your_random_token_here

# add_attachment 的 file_path 模式僅允許讀取此目錄底下的檔案（預設 /shared/uploads，對齊 compose 圖片傳遞通道）
# 純本機 stdio 若要放行任意路徑，設為 /（自負風險，等於解除限制）
# UPLOAD_DIR=/shared/uploads